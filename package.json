{
  "name": "syncnest",
  "version": "1.0.0",
  "description": "SyncNest — A premium cross-platform desktop SQL database browser for local SQLite files",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.sqlbrowser.app",
    "productName": "SyncNest",
    "publish": [
      {
        "provider": "github",
        "owner": "Sundanpatyad",
        "repo": "SyncNest"
      }
    ],
    "directories": {
      "output": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "sqlite",
    "database",
    "browser",
    "electron",
    "sql"
  ],
  "author": "SyncNest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sundanpatyad/SyncNest.git"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.8.3",
    "sql.js": "^1.14.1"
  }
}
